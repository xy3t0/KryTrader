# Normalize line endings to LF in the repo (avoids CRLF churn across OSes).
* text=auto eol=lf

# Keep binary assets untouched.
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary

# Captured API bodies are byte-exact evidence (SHA-256 checked); never rewrite them.
python/tests/fixtures/** -text
